# Copy this file to .env (in the project root) and fill in YOUR OWN values. Never commit .env.
# DATABASE_URL format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/battery_db
# Generate a value with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_value